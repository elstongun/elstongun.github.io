---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<main>
	<img
		class="home-image"
		src="/home-image.jpg"
		alt="Death on the Pale Horse, Gustave Doré"
		width="320"
		height="320"
	/>
	<p>
		Personal site and blog. I previously worked on high frequency trading infrastructure, now I work
		on making factories smart.
	</p>
	<h2>Recent posts</h2>
	<ul class="post-list">
		{
			posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						<span class="post-title">{post.data.title}</span>
						<span class="post-date">
							<FormattedDate date={post.data.pubDate} />
						</span>
					</a>
					<p>{post.data.description}</p>
				</li>
			))
		}
	</ul>
	<p><a href="/blog/">All posts →</a></p>
</main>

<style>
	.home-image {
		display: block;
		width: 320px;
		max-width: 100%;
		height: auto;
		margin: 0 0 1.5em 0;
		border-radius: 0;
	}
	h2 {
		margin-top: 2em;
		font-size: 1.25em;
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1em 0;
	}
	.post-list li {
		margin: 0 0 1.25em 0;
	}
	.post-list a {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: baseline;
		text-decoration: none;
	}
	.post-title {
		color: var(--fg);
	}
	.post-date {
		color: rgb(var(--gray));
		font-size: 0.9rem;
		white-space: nowrap;
	}
	.post-list p {
		margin: 0.25em 0 0 0;
		color: rgb(var(--gray));
		font-size: 0.95em;
	}
</style>
