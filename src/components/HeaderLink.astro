---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const normalized = pathname.endsWith('/') ? pathname : `${pathname}/`;
const hrefValue = String(href ?? '');
const hrefNormalized = hrefValue.endsWith('/') ? hrefValue : `${hrefValue}/`;

const homePaths = new Set(['/', '/home/', '/index.html/']);
const isHomeLink = hrefNormalized === '/home/' || hrefNormalized === '/';
const onHome = homePaths.has(normalized) || normalized === '/index.html/';
const isActive = isHomeLink
	? onHome
	: hrefNormalized === normalized || normalized.startsWith(hrefNormalized);
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
