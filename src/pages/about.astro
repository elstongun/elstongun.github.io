---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SOCIAL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About" description="About elstong." />
	</head>
	<body>
		<Header />
		<main>
			<h1>About</h1>
			<p>
				I'm Joshua (elstong / elstongun). I write software, mostly around Ethereum: trading
				systems, smart contracts, and the interfaces that sit on top of them.
			</p>
			<p>
				Recent work has been on <a href="https://aori.io">Aori</a>. Older public repos cover OTC
				flow, AMMs, and a few experiments that never needed to stay private.
			</p>
			<p>
				This site is for longer notes than social media. Posts live as Markdown in
				<code>src/content/blog/</code>.
			</p>
			<p>
				<a href={SOCIAL.github}>GitHub</a> · <a href={SOCIAL.x}>X</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
